{
	"get": {
		"operationId": "getInitiativeById",
		"summary": "Gets a specific initiative.",
		"description": "Requires `view` permission at the `initiative` scope on the initiative or on its changemaker.",
		"tags": ["Initiatives"],
		"security": [
			{
				"auth": []
			}
		],
		"parameters": [
			{
				"name": "initiativeId",
				"description": "The PDC-generated ID of an initiative.",
				"in": "path",
				"required": true,
				"schema": {
					"$ref": "../components/schemas/id.json"
				}
			}
		],
		"responses": {
			"200": {
				"description": "The requested initiative.",
				"content": {
					"application/json": {
						"schema": {
							"$ref": "../components/schemas/Initiative.json"
						}
					}
				}
			},
			"400": {
				"$ref": "../components/responses/InputValidation.json"
			},
			"401": {
				"$ref": "../components/responses/Unauthorized.json"
			},
			"404": {
				"$ref": "../components/responses/NotFound.json",
				"description": "The initiative could not be found, or the caller may not view it."
			},
			"500": {
				"$ref": "../components/responses/InternalServerError.json"
			}
		}
	},
	"patch": {
		"operationId": "updateInitiativeById",
		"summary": "Updates the title of a specific initiative.",
		"description": "Requires `edit` permission at the `initiative` scope on the initiative or on its changemaker.",
		"tags": ["Initiatives"],
		"security": [
			{
				"auth": []
			}
		],
		"parameters": [
			{
				"name": "initiativeId",
				"description": "The PDC-generated ID of an initiative.",
				"in": "path",
				"required": true,
				"schema": {
					"$ref": "../components/schemas/id.json"
				}
			}
		],
		"requestBody": {
			"required": true,
			"content": {
				"application/json": {
					"schema": {
						"$ref": "../components/schemas/InitiativePatch.json"
					}
				}
			}
		},
		"responses": {
			"200": {
				"description": "The updated initiative.",
				"content": {
					"application/json": {
						"schema": {
							"$ref": "../components/schemas/Initiative.json"
						}
					}
				}
			},
			"400": {
				"$ref": "../components/responses/InputValidation.json"
			},
			"401": {
				"$ref": "../components/responses/Unauthorized.json"
			},
			"403": {
				"$ref": "../components/responses/Forbidden.json",
				"description": "The caller may view the initiative but may not edit it."
			},
			"404": {
				"$ref": "../components/responses/NotFound.json",
				"description": "The initiative could not be found, or the caller may not view it."
			},
			"500": {
				"$ref": "../components/responses/InternalServerError.json"
			}
		}
	}
}

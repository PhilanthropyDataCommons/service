{
	"get": {
		"operationId": "getInitiatives",
		"summary": "Gets a list of initiatives.",
		"description": "Returns a paginated list of initiatives the caller has permission to view. Optionally filter by changemaker.",
		"tags": ["Initiatives"],
		"security": [
			{
				"auth": []
			}
		],
		"parameters": [
			{ "$ref": "../components/parameters/pageParam.json" },
			{ "$ref": "../components/parameters/countParam.json" },
			{ "$ref": "../components/parameters/changemakerParam.json" }
		],
		"responses": {
			"200": {
				"description": "All initiatives matching the filter criteria that the caller has permission to view.",
				"content": {
					"application/json": {
						"schema": {
							"$ref": "../components/schemas/InitiativeBundle.json"
						}
					}
				}
			},
			"400": {
				"$ref": "../components/responses/InputValidation.json"
			},
			"401": {
				"$ref": "../components/responses/Unauthorized.json"
			},
			"500": {
				"$ref": "../components/responses/InternalServerError.json"
			}
		}
	},
	"post": {
		"operationId": "addInitiative",
		"summary": "Creates a new initiative for a changemaker.",
		"description": "Requires `edit` permission at the `initiative` scope on the changemaker that will own the initiative.",
		"tags": ["Initiatives"],
		"security": [
			{
				"auth": []
			}
		],
		"requestBody": {
			"required": true,
			"content": {
				"application/json": {
					"schema": {
						"$ref": "../components/schemas/Initiative.json"
					}
				}
			}
		},
		"responses": {
			"201": {
				"description": "The new initiative that was created.",
				"content": {
					"application/json": {
						"schema": {
							"$ref": "../components/schemas/Initiative.json"
						}
					}
				}
			},
			"400": {
				"$ref": "../components/responses/InputValidation.json"
			},
			"401": {
				"$ref": "../components/responses/Unauthorized.json"
			},
			"403": {
				"$ref": "../components/responses/Forbidden.json",
				"description": "The caller may not create initiatives for the specified changemaker."
			},
			"404": {
				"$ref": "../components/responses/NotFound.json",
				"description": "The specified changemaker could not be found, or the caller may not view it."
			},
			"500": {
				"$ref": "../components/responses/InternalServerError.json"
			}
		}
	}
}

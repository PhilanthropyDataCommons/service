{
	"get": {
		"operationId": "getUsers",
		"summary": "Gets a list of users.",
		"description": "Returns the caller's own user record, and additionally every other user when the caller's JWT carries at least one of the Keycloak `realm-management` user-visibility roles (`query-users`, `view-users`, or `manage-users`).",
		"tags": ["Users"],
		"security": [
			{
				"auth": []
			}
		],
		"parameters": [
			{
				"$ref": "../components/parameters/pageParam.json"
			},
			{
				"$ref": "../components/parameters/countParam.json"
			},
			{
				"$ref": "../components/parameters/keycloakUserIdParam.json"
			}
		],
		"responses": {
			"200": {
				"description": "A list of users.",
				"content": {
					"application/json": {
						"schema": {
							"$ref": "../components/schemas/UserBundle.json"
						}
					}
				}
			},
			"401": {
				"$ref": "../components/responses/Unauthorized.json"
			},
			"404": {
				"$ref": "../components/responses/NotFound.json"
			},
			"500": {
				"$ref": "../components/responses/InternalServerError.json"
			}
		}
	}
}
